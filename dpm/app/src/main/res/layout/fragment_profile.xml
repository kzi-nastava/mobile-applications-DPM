<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TIP KORISNIKA -->
        <RadioGroup
            android:id="@+id/rgUserType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_gravity="center_horizontal">

            <RadioButton
                android:id="@+id/rbDriver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:layout_marginStart="16dp"/>

        </RadioGroup>


        <!-- PROFILNA SLIKA + DUGMAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- SLIKA -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:padding="8dp"
                android:src="@drawable/profile_image" />

            <!-- DUGMAD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <Button
                    android:id="@+id/btnAddImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add a profile image"
                    android:backgroundTint="@color/dark_blue"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnChangeImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change profile image"
                    android:backgroundTint="@color/orange"
                    android:textColor="@color/white"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:text="User data"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:hint="Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Miroslav"/>

        <EditText
            android:hint="Lastname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đaković"/>

        <EditText
            android:hint="Email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="micakamiondzija@gmail.com"/>

        <EditText
            android:hint="Address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-Petra Dobrivića 16"/>

        <EditText
            android:hint="Phone number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+381612132104"/>

        <!-- VOZAČ INFO -->
        <LinearLayout
            android:id="@+id/layoutDriverInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="Driver"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/dark_blue"
                android:layout_marginTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Active for 5 hours in the last 24 hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Vehicle"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Mark: Toyota"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Model: Corolla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Registration: BG-123-AB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <!-- ADMIN ODOBRENJE -->
            <TextView
                android:text="Changes are pending admin approval"
                android:textColor="@color/orange"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnRequestChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit a change request"
                android:backgroundTint="@color/dark_blue"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save changes"
            android:backgroundTint="@color/dark_blue"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change password"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
