<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_blue">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- PROFILNA SLIKA + DUGMAD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- SLIKA -->
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="wrap_content"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:background="@color/white"
                android:padding="8dp" />

            <!-- DUGMAD -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="16dp">

                <Button
                    android:id="@+id/btnAddImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add a profile image"
                    android:backgroundTint="@color/dark_blue"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnChangeImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Change profile image"
                    android:backgroundTint="@color/orange"
                    android:textColor="@color/white"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:text="User data"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etName"
            android:hint="Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etLastName"
            android:hint="Lastname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etEmail"
            android:hint="Email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etPhoneNumber"
            android:hint="Phone number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etCountry"
            android:hint="Country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etCity"
            android:hint="City"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etStreet"
            android:hint="Street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>

        <EditText
            android:id="@+id/etNumber"
            android:hint="Number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""/>


        <!-- VOZAČ INFO -->
        <LinearLayout
            android:id="@+id/layoutDriverInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:text="Driver"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/dark_blue"
                android:layout_marginTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvActiveHours"
                android:text="Active for 0 hours in the last 24 hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Vehicle"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvModel"
                android:text="Model: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvRegistration"
                android:text="Registration: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvSeats"
                android:text="Seats: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvPetFreindly"
                android:text="Pet friendly: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvBabyFriendly"
                android:text="Baby friendly: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <!-- ADMIN ODOBRENJE -->
            <TextView
                android:text="Changes are pending admin approval"
                android:textColor="@color/orange"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnRequestChange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit a change request"
                android:backgroundTint="@color/dark_blue"
                android:textColor="@color/white"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save changes"
            android:backgroundTint="@color/dark_blue"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change password"
            android:backgroundTint="@color/orange"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
